rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        (
          // Caller is PARENT
          firestore.exists(/databases/(default)/documents/restaurants/$(userId)) &&
          firestore.get(/databases/(default)/documents/restaurants/$(userId)).data.parentId == request.auth.uid
        ) ||
        (
          // Caller is OUTLET
          firestore.exists(/databases/(default)/documents/restaurants/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/restaurants/$(request.auth.uid)).data.parentId == userId
        )
      );
    }

    // Per-restaurant menu item images.
    function isPlatformAdmin() {
      return request.auth != null && request.auth.token.get("platformAdmin", false) == true;
    }
    // Every write is bounded: images for public media, images or PDF for
    // identity documents. Writes used to accept any type and any size. The apps
    // upload without explicit metadata, so an uninferred type (octet-stream) is
    // tolerated rather than breaking existing uploads; size caps always apply.
    function imageUpload(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/octet-stream');
    }
    function documentUpload() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/octet-stream');
    }
    // KYC files (PAN, Aadhaar, GST, bank proof) live under <owner>/kyc/. They
    // sat inside folders with PUBLIC read, and the owner id is a public
    // restaurant/hotel id, so anyone could fetch them by path.
    function isKycPath(p) {
      // Wildcard captures are paths, not strings: `p.matches` threw on every
      // request, so every upload under restaurants/, hotels/ and mess_kitchens/
      // was refused.
      return string(p).matches('^/?kyc/.*');
    }

    match /menu_items/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && (request.resource == null || imageUpload(10));
    }

    // Per-restaurant logo uploads (Settings → branding).
    match /logos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && (request.resource == null || imageUpload(10));
    }

    // Per-restaurant marketing creative uploads (Marketing → Ads).
    match /ads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && (request.resource == null || imageUpload(10));
    }

    // Generic per-restaurant namespace for any new uploads added later.
    match /restaurants/{userId}/{allPaths=**} {
      allow read: if !isKycPath(allPaths) || isOwner(userId) || isPlatformAdmin();
      allow write: if isOwner(userId) && (
        request.resource == null ||
        (isKycPath(allPaths) ? documentUpload() : imageUpload(10))
      );
    }

    // Kada Mess kitchens: kitchen photos, weekly menus and KYC documents.
    // Owned by the kitchen's own login only (no parent/outlet model).
    match /mess_kitchens/{userId}/{allPaths=**} {
      allow read: if !isKycPath(allPaths) || (request.auth != null && request.auth.uid == userId) || isPlatformAdmin();
      allow write: if request.auth != null && request.auth.uid == userId && (
        request.resource == null ||
        (isKycPath(allPaths) ? documentUpload() : imageUpload(10))
      );
    }

    // Per-hotel property images & branding (KadaStay / Host App).
    match /hotels/{userId}/{allPaths=**} {
      allow read: if !isKycPath(allPaths) || (request.auth != null && request.auth.uid == userId) || isPlatformAdmin();
      allow write: if request.auth != null && request.auth.uid == userId && (
        request.resource == null ||
        (isKycPath(allPaths) ? documentUpload() : imageUpload(10))
      );
    }

    // Per-hotel room photos (KadaStay / Host App).
    match /rooms/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Staff avatars (Staff management).
    match /staff_avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && (request.resource == null || imageUpload(5));
    }

    // Customer & user profile avatars.
    match /user_avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && (request.resource == null || imageUpload(5));
    }

    // Rider KYC documents (driving licence, vehicle photo). Each rider writes
    // only their own; the admin Fleet panel views them via tokenized download
    // URLs (which bypass these rules), so owner-only read/write is sufficient.
    match /rider_documents/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isPlatformAdmin();
      allow write: if request.auth != null && request.auth.uid == userId && (request.resource == null || documentUpload());
    }

    // Kada Stay host property KYC documents (GST cert, PAN, registration, owner ID).
    match /hotel_documents/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isPlatformAdmin();
      allow write: if request.auth != null && request.auth.uid == userId && (request.resource == null || documentUpload());
    }

    // Delivery proofs (photos taken by riders during drop-off).
    // Riders upload them, and restaurants/customers might need to view them.
    match /delivery_proofs/{allPaths=**} {
      // Doorstep photos of customers' homes. They were world-readable, and any
      // signed-in user could overwrite one. Files are "<orderId>_<time>.jpg".
      allow read: if request.auth != null && (
        isPlatformAdmin() ||
        firestore.get(/databases/(default)/documents/orders/$(string(allPaths).replace('^/', '').split('_')[0])).data.get('riderId', '') == request.auth.uid ||
        firestore.get(/databases/(default)/documents/orders/$(string(allPaths).replace('^/', '').split('_')[0])).data.get('customerUid', '') == request.auth.uid
      );
      allow write: if request.auth != null && resource == null && imageUpload(12) &&
        firestore.get(/databases/(default)/documents/orders/$(string(allPaths).replace('^/', '').split('_')[0])).data.get('riderId', '') == request.auth.uid;
    }

    // Support-chat attachments (photos of a spoiled/missing item, voice notes)
    // uploaded from the customer / vendor / rider apps. Any signed-in user may
    // upload; reads are public so the AI bot + admin agents can view them via
    // the download URL. Capped to keep abuse in check.
    // Rider onboarding KYC (delivery_mobile_app). No rule matched this path, so
    // every rider KYC upload was refused.
    match /delivery_users/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isPlatformAdmin();
      allow write: if request.auth != null && request.auth.uid == userId && (request.resource == null || documentUpload());
    }
    // Customer profile photos (customer_mobile_app), stored as <uid>.jpg. No
    // rule matched this path, so every upload was refused.
    match /profile_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg' &&
        (request.resource == null || imageUpload(5));
    }
    // Web dashboard menu images (src/pages/dashboard). No rule matched here either.
    match /menu/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && (request.resource == null || imageUpload(10));
    }
    match /support_images/{allPaths=**} {
      // Support attachments can show addresses, bills or faces: signed-in only.
      // Chat renders them via download URLs, which keep working.
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*');
    }
    match /support_media/{allPaths=**} {
      // Support attachments can show addresses, bills or faces: signed-in only.
      // Chat renders them via download URLs, which keep working.
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*');
    }

    // Changelog media — cover images and screenshots shown on the website and
    // in every app, so public read. Only platform admins upload.
    match /changelog_media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (isPlatformAdmin()
          || request.auth.token.email in ['thekada@gmail.com', 'thekadaapp@gmail.com'])
        && (request.resource == null || imageUpload(8));
    }

    // No catch-all. Previously a single rule allowed any authenticated user
    // to read/write any path, which let tenant A overwrite tenant B's assets.
    // Anything outside the per-tenant namespaces above is denied by default.
  }
}
