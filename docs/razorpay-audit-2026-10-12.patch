-/**
- * Pick the latest_receipt_info entry with the largest expires_date_ms — this
- * represents the user's most recent state (renewal, upgrade, etc.).
- */
-function pickLatestEntry(
-  entries: AppleLatestReceiptInfo[] | undefined,
-): AppleLatestReceiptInfo | null {
-  if (!entries || entries.length === 0) return null;
-  return entries.reduce<AppleLatestReceiptInfo | null>((latest, current) => {
-    const a = Number(latest?.expires_date_ms ?? 0);
-    const b = Number(current?.expires_date_ms ?? 0);
-    return b > a ? current : latest;
-  }, null);
-}
-
-async function postAppleVerify(
-  url: string,
-  body: Record<string, unknown>,
-): Promise<AppleVerifyResponse> {
-  const res = await fetch(url, {
-    method: "POST",
-    headers: { "Content-Type": "application/json" },
-    body: JSON.stringify(body),
-  });
-  if (!res.ok) throw new Error(`Apple verifyReceipt HTTP ${res.status}`);
-  return (await res.json()) as AppleVerifyResponse;
-}
-
-function billingPrivateRef(uid: string) {
-  return admin.firestore().collection("billing_private").doc(uid);
-}
-
-/**
- * Apply a verified Apple receipt to Firestore.
- * Idempotent on `originalTransactionId`.
- */
-async function applyAppleSubscriptionState(opts: {
-  uid: string;
-  entry: AppleLatestReceiptInfo;
-  latestReceipt: string | undefined;
-  environment: "Production" | "Sandbox";
-  renewal?: RenewalState;
-}): Promise<{
-  status: string;
-  expiresAt: string | null;
-  planTier: string;
-  renewal: RenewalState;
-}> {
-  const { uid, entry, latestReceipt, environment } = opts;
-  const renewal = opts.renewal ?? emptyRenewalState();
-  const planInfo = PRODUCT_PLAN_MAP[entry.product_id];
-  if (!planInfo) {
-    throw new HttpsError(
-      "failed-precondition",
-      `Unknown subscription product: ${entry.product_id}`,
-    );
-  }
-
-  const expiresMs = Number(entry.expires_date_ms ?? 0);
-  const cancelledMs = Number(entry.cancellation_date_ms ?? 0);
-  const now = Date.now();
-
-  let status: "active" | "expired" | "refunded" | "trial" = "active";
-  if (cancelledMs > 0) status = "refunded";
-  else if (expiresMs > 0 && expiresMs < now) {
-    // Grace period means Apple is retrying billing — keep the user active
-    // until the grace window closes.
-    status = renewal.inGracePeriod ? "active" : "expired";
-  } else if (entry.is_trial_period === "true") {
-    status = "trial";
-  }
-
-  const expiresAt = expiresMs > 0 ? new Date(expiresMs).toISOString() : null;
-  const nowIso = new Date().toISOString();
-  const isHotelPlan = ["basic", "pro", "enterprise"].includes(planInfo.tier);
-
-  const subPayload = {
-    subscriptionType: planInfo.billing,
-    planTier: planInfo.tier,
-    plan: planInfo.tier,
-    subscriptionStatus: status,
-    status: status,
-    subscriptionEndDate: expiresAt,
-    expiryDate: expiresAt,
-    isTrial: entry.is_trial_period === "true",
-    lastRenewalDate: nowIso,
-    lastReceiptValidatedAt: nowIso,
-    isBlocked: status !== "active" && status !== "trial",
-    autoRenewEnabled: renewal.autoRenewEnabled,
-    expirationIntent: renewal.expirationIntent,
-    inBillingRetry: renewal.inBillingRetry,
-    inGracePeriod: renewal.inGracePeriod,
-    gracePeriodEndsAt: renewal.gracePeriodEndsAt,
-    accountHold: renewal.accountHold,
-  };
-
-  if (isHotelPlan) {
-    await admin.firestore().collection("hotels").doc(uid).set(subPayload, { merge: true });
-    await admin.firestore().collection("subscriptions").doc(uid).set(subPayload, { merge: true });
-  } else {
-    await admin.firestore().collection("restaurants").doc(uid).set(subPayload, { merge: true });
-  }
-
-  await billingPrivateRef(uid).set(
-    {
-      appleLatestReceipt: latestReceipt ?? null,
-      appleEnvironment: environment,
-      appleOriginalTransactionId: entry.original_transaction_id ?? null,
-      appleProductId: entry.product_id,
-      applePlanTier: planInfo.tier,
-      appleBillingPeriod: planInfo.billing,
-      appleLatestTransactionId: entry.transaction_id ?? null,
-      appleLastReceiptValidatedAt: nowIso,
-      updatedAt: nowIso,
-    },
-    { merge: true },
-  );
-
-  return { status, expiresAt, planTier: planInfo.tier, renewal };
-}
-
-/**
- * Callable from Flutter:
- *
- *   final callable = FirebaseFunctions.instance.httpsCallable('verifyAppStoreReceipt');
- *   await callable.call({ 'receipt': purchase.verificationData.serverVerificationData });
- *
- * The function infers the calling user from the auth context.
- */
-export const verifyAppStoreReceipt = onCall(
-  { secrets: [APPLE_SHARED_SECRET] },
-  async (request) => {
-    const uid = request.auth?.uid;
-    if (!uid) {
-      throw new HttpsError(
-        "unauthenticated",
-        "Sign in before verifying a receipt.",
-      );
-    }
-    const receipt = request.data?.receipt as string | undefined;
-    if (!receipt || receipt.length < 16) {
-      throw new HttpsError(
-        "invalid-argument",
-        "Missing iOS receipt blob in `receipt` field.",
-      );
-    }
-
-    const body = {
-      "receipt-data": receipt,
-      password: APPLE_SHARED_SECRET.value(),
-      "exclude-old-transactions": true,
-    };
-
-    // Try production first; if Apple says status=21007 it's a sandbox
-    // receipt — retry against sandbox. This is the documented flow.
-    let response = await postAppleVerify(APPLE_VERIFY_PRODUCTION, body);
-    let environment: "Production" | "Sandbox" = "Production";
-    if (response.status === 21007) {
-      response = await postAppleVerify(APPLE_VERIFY_SANDBOX, body);
-      environment = "Sandbox";
-    }
-    if (response.status !== 0) {
-      logger.warn("Apple verifyReceipt non-zero status", {
-        status: response.status,
-        uid,
-      });
-      throw new HttpsError(
-        "permission-denied",
-        `Apple receipt invalid (status ${response.status}).`,
-      );
-    }
-
-    const entry = pickLatestEntry(response.latest_receipt_info);
-    if (!entry) {
-      throw new HttpsError(
-        "failed-precondition",
-        "Receipt has no subscription transactions.",
-      );
-    }
-
-    const pending = pickApplePendingEntry(
-      response.pending_renewal_info,
-      entry.product_id,
-    );
-    const renewal = parseAppleRenewalState(pending);
-
-    const result = await applyAppleSubscriptionState({
-      uid,
-      entry,
-      latestReceipt: response.latest_receipt,
-      environment,
-      renewal,
-    });
-
-    return { ok: true, ...result, environment };
-  },
-);
