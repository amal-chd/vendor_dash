-  }
-
-  if (!raw || raw.trim().length < 20) {
-    logger.error(
-      "PLAY_SERVICE_ACCOUNT_JSON secret is empty or truncated " +
-        `(length=${raw?.length ?? 0}, preview=${JSON.stringify(raw?.substring(0, 30))}). ` +
-        "This usually happens when multi-line JSON is pasted interactively. " +
-        "Re-set using file redirection: " +
-        "firebase functions:secrets:set PLAY_SERVICE_ACCOUNT_JSON < /path/to/service-account.json",
-    );
-    throw new HttpsError(
