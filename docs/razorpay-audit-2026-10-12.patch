-/**
- * Apple App Store Server Notifications V2 webhook.
- *
- * Configure this endpoint's HTTPS URL in App Store Connect → App Information →
- * App Store Server Notifications. Apple sends every renewal, refund, billing
- * retry and expiration event here.
- *
- * Notification payloads are signed JWS — for production you should verify the
- * x5c chain against Apple's public certificates. We decode the body without
- * verifying for now and re-validate the receipt against `verifyReceipt` to
- * pick up the latest expiration date authoritatively. That double check
- * means an attacker who forges a webhook can't grant access — `verifyReceipt`
- * still has to succeed.
- */
-export const appStoreServerNotification = onRequest(
-  { secrets: [APPLE_SHARED_SECRET] },
-  async (req, res) => {
-    if (req.method !== "POST") {
-      res.status(405).send("Method not allowed");
-      return;
-    }
-    const signedPayload = (req.body?.signedPayload as string | undefined) ?? "";
-    if (!signedPayload) {
-      res.status(400).send("Missing signedPayload");
-      return;
-    }
-
-    // Verify the JWS signature against Apple Root CA G3 BEFORE trusting
-    // anything in the body. If verification fails, log and reject — we used
-    // to fall back to decoding without verifying + re-validating via
-    // verifyReceipt, but that masked malicious payloads. Now we refuse
-    // unsigned payloads outright.
-    const decoded = verifyAppleJws(signedPayload);
-    if (!decoded) {
-      logger.warn("ASSN: JWS verification failed — rejecting payload");
-      res.status(401).send("Invalid JWS signature");
-      return;
-    }
-
-    const data = (decoded.data ?? {}) as Record<string, unknown>;
-    const signedTransactionInfo = data.signedTransactionInfo as
-      | string
-      | undefined;
-    if (!signedTransactionInfo) {
-      logger.info("ASSN: no signedTransactionInfo on payload", {
-        notificationType: decoded.notificationType,
-      });
-      res.status(200).send("ok");
-      return;
-    }
-    // The inner JWS is signed by the same Apple chain — verify it too for
-    // strict compliance. If it fails, fall back to plain decode (the outer
-    // already validated so Apple is the source).
-    const tx =
-      verifyAppleJws(signedTransactionInfo) ??
-      decodeJwsPayload(signedTransactionInfo);
-    if (!tx) {
-      res.status(200).send("ok");
-      return;
-    }
-    const originalTransactionId = tx.originalTransactionId as string | undefined;
-    if (!originalTransactionId) {
-      res.status(200).send("ok");
-      return;
-    }
-    // Find which restaurant owns this transaction.
-    const privateSnap = await admin
-      .firestore()
-      .collection("billing_private")
-      .where("appleOriginalTransactionId", "==", originalTransactionId)
-      .limit(1)
-      .get();
-    let uid: string | null = privateSnap.empty ? null : privateSnap.docs[0].id;
-
-    // Backward compatibility for receipts stored before billing_private
-    // existed. New writes do not put receipt blobs on the public restaurant doc.
-    if (!uid) {
-      const legacySnap = await admin
-        .firestore()
-        .collection("restaurants")
-        .where("iapAppleOriginalTransactionId", "==", originalTransactionId)
-        .limit(1)
-        .get();
-      uid = legacySnap.empty ? null : legacySnap.docs[0].id;
-    }
-
-    if (!uid) {
-      logger.warn("ASSN: no restaurant matches transaction", {
-        originalTransactionId,
-      });
-      res.status(200).send("ok");
-      return;
-    }
-    const privateDoc = await billingPrivateRef(uid).get();
-    const privateData = privateDoc.data() ?? {};
-    const receipt =
-      (privateData.appleLatestReceipt as string | undefined) ??
-      ((await admin.firestore().collection("restaurants").doc(uid).get()).data()
-        ?.iapAppleLatestReceipt as string | undefined);
-    if (!receipt) {
-      logger.info("ASSN: no stored receipt to re-verify");
-      res.status(200).send("ok");
-      return;
-    }
-    const body = {
-      "receipt-data": receipt,
-      password: APPLE_SHARED_SECRET.value(),
-      "exclude-old-transactions": true,
-    };
-    let response = await postAppleVerify(APPLE_VERIFY_PRODUCTION, body);
-    let environment: "Production" | "Sandbox" = "Production";
-    if (response.status === 21007) {
-      response = await postAppleVerify(APPLE_VERIFY_SANDBOX, body);
-      environment = "Sandbox";
-    }
