-function getPlayServiceAccount(): PlayServiceAccount {
-  let raw: string;
-  try {
-    raw = PLAY_SERVICE_ACCOUNT_JSON.value();
-  } catch (accessErr) {
-    logger.error(
-      "PLAY_SERVICE_ACCOUNT_JSON secret could not be accessed at all. " +
-        "Has it been set? Run: firebase functions:secrets:set PLAY_SERVICE_ACCOUNT_JSON < /path/to/service-account.json",
-      { err: accessErr },
-    );
-    throw new HttpsError(
-      "failed-precondition",
-      "Google Play service account secret is not accessible. " +
-        "The admin must configure it via: " +
-        "firebase functions:secrets:set PLAY_SERVICE_ACCOUNT_JSON < /path/to/service-account.json",
