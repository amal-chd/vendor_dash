-// ────────────────────────────────────────────────────────────────────────────
-// JWS verification — Apple App Store Server Notifications V2 signs every
-// payload with an ES256 signature whose certificate chain leads to
-// Apple Root CA G3. Without verifying the signature, the webhook trusts
-// anything posted to its URL.
-//
-// `verifyAppleJws` returns the decoded payload only if:
-//   1. The header parses and contains an x5c chain of >= 2 certs.
-//   2. The leaf cert is currently valid (notBefore <= now <= notAfter).
-//   3. Each cert in the chain was issued by the next (subject == issuer +
-//      signature OK).
-//   4. The root of the chain matches Apple Root CA G3 (same DER bytes).
-//   5. The ES256 signature over `header.payload` verifies against the
-//      leaf's public key.
-//
-// Returns null on any failure; the caller falls back to a
-// less-trusting re-verification path.
-// ────────────────────────────────────────────────────────────────────────────
-const appleRootCert = new X509Certificate(APPLE_ROOT_CA_G3_PEM);
-const APPLE_ROOT_DER_B64 = appleRootCert.raw.toString("base64");
-
-/**
- * Convert ECDSA P-256 JWS signature (r||s, 64 bytes) to DER format that
- * Node's `crypto.verify` expects.
- */
-function ecdsaJwsToDer(jws: Buffer): Buffer {
-  if (jws.length !== 64) return jws; // already DER, hopefully
-  const r = jws.subarray(0, 32);
-  const s = jws.subarray(32, 64);
-  // Strip leading zero bytes; add one back if high bit is set (DER positivity)
-  const trim = (b: Buffer) => {
-    let i = 0;
-    while (i < b.length - 1 && b[i] === 0) i++;
-    const out = b.subarray(i);
-    return out[0] & 0x80 ? Buffer.concat([Buffer.from([0]), out]) : out;
-  };
-  const rT = trim(r);
-  const sT = trim(s);
-  return Buffer.concat([
-    Buffer.from([0x30, 2 + rT.length + 2 + sT.length]),
-    Buffer.from([0x02, rT.length]),
-    rT,
-    Buffer.from([0x02, sT.length]),
-    sT,
-  ]);
-}
-
-function certFromB64Der(b64: string): X509Certificate | null {
-  try {
-    const der = Buffer.from(b64, "base64");
-    return new X509Certificate(der);
-  } catch {
-    return null;
-  }
-}
-
-/**
- * Verify the JWS signature + x5c chain against Apple's Root CA G3.
- * Returns the parsed payload if everything checks out, else null.
- */
-function verifyAppleJws(jws: string): Record<string, unknown> | null {
-  const parts = jws.split(".");
-  if (parts.length !== 3) return null;
-  const [headerB64, payloadB64, sigB64] = parts;
-
-  // 1. Parse header + extract x5c chain.
-  let header: { alg?: string; x5c?: string[] };
-  try {
-    header = JSON.parse(Buffer.from(headerB64, "base64url").toString("utf8"));
-  } catch {
-    return null;
-  }
-  if (header.alg !== "ES256") return null;
-  const x5c = header.x5c;
-  if (!Array.isArray(x5c) || x5c.length < 2) return null;
-
-  // 2. Parse certs.
-  const certs = x5c.map(certFromB64Der);
-  if (certs.some((c) => c === null)) return null;
-  const chain = certs as X509Certificate[];
-  const leaf = chain[0];
-  const root = chain[chain.length - 1];
-
-  // 3. Leaf time validity.
-  const now = Date.now();
-  if (Date.parse(leaf.validFrom) > now) return null;
-  if (Date.parse(leaf.validTo) < now) return null;
-
-  // 4. Chain validation — each cert verified by the next, then root must
-  //    equal Apple Root CA G3.
-  for (let i = 0; i < chain.length - 1; i++) {
-    if (!chain[i].verify(chain[i + 1].publicKey)) {
-      logger.warn("ASSN: chain cert " + i + " failed verify");
-      return null;
-    }
-  }
-  if (root.raw.toString("base64") !== APPLE_ROOT_DER_B64) {
-    // The chain's terminal cert isn't Apple Root CA G3 — could be the
-    // intermediate, in which case validate it against the bundled root.
-    if (!root.verify(appleRootCert.publicKey)) {
-      logger.warn("ASSN: chain does not lead to Apple Root CA G3");
-      return null;
-    }
-  }
-
-  // 5. Verify the JWS signature over `header.payload` with the leaf key.
-  const signature = ecdsaJwsToDer(Buffer.from(sigB64, "base64url"));
-  const data = Buffer.from(`${headerB64}.${payloadB64}`, "utf8");
-  const verifier = createVerify("SHA256");
-  verifier.update(data);
-  verifier.end();
-  const ok = verifier.verify(
-    createPublicKey(leaf.publicKey),
-    signature,
-  );
-  if (!ok) {
-    logger.warn("ASSN: JWS signature did not verify against leaf");
-    return null;
-  }
-
-  // 6. Signature OK — parse payload and return.
-  try {
-    return JSON.parse(Buffer.from(payloadB64, "base64url").toString("utf8"));
-  } catch {
-    return null;
-  }
-}
-
-/**
- * Decode the payload of a JWS without verifying. Kept as a fallback for
- * inner payloads where the chain has already been validated by the wrapping
- * JWS (Apple nests signedTransactionInfo / signedRenewalInfo under the
- * outer signedPayload).
- */
-export function decodeJwsPayload(jws: string): Record<string, unknown> | null {
-  const parts = jws.split(".");
-  if (parts.length !== 3) return null;
-  try {
-    const json = Buffer.from(parts[1], "base64url").toString("utf8");
-    return JSON.parse(json);
-  } catch {
-    return null;
-  }
-}
-
-function encodeBase64Url(input: Record<string, unknown>) {
-  return Buffer.from(JSON.stringify(input)).toString("base64url");
-}
