-/**
- * Renewal metadata distilled into a flat shape we write to Firestore.
- * Stays the same whether the source is verifyReceipt or App Store Server
- * Notifications, so the client can treat them uniformly.
- */
-export interface RenewalState {
-  autoRenewEnabled: boolean | null;
-  expirationIntent: number | null;     // 1..5 (Apple) or mapped equivalent (Play)
-  inBillingRetry: boolean;
-  inGracePeriod: boolean;
-  gracePeriodEndsAt: string | null;    // ISO-8601 or null
-  accountHold: boolean;
-}
-
-export function emptyRenewalState(): RenewalState {
-  return {
-    autoRenewEnabled: null,
-    expirationIntent: null,
-    inBillingRetry: false,
-    inGracePeriod: false,
-    gracePeriodEndsAt: null,
-    accountHold: false,
-  };
-}
-
-export function pickApplePendingEntry(
-  entries: ApplePendingRenewalEntry[] | undefined,
-  productId: string,
-): ApplePendingRenewalEntry | null {
-  if (!entries || entries.length === 0) return null;
-  // Prefer the exact product, otherwise fall back to the first entry.
-  return entries.find((e) => e.product_id === productId) ?? entries[0];
-}
-
-export function parseAppleRenewalState(
-  pending: ApplePendingRenewalEntry | null,
-): RenewalState {
-  if (!pending) return emptyRenewalState();
-  const graceMs = Number(pending.grace_period_expires_date_ms ?? 0);
-  return {
-    autoRenewEnabled:
-      pending.auto_renew_status === undefined
-        ? null
-        : pending.auto_renew_status === "1",
-    expirationIntent: pending.expiration_intent
-      ? Number(pending.expiration_intent)
-      : null,
-    inBillingRetry: pending.is_in_billing_retry_period === "1",
-    inGracePeriod: graceMs > 0 && graceMs > Date.now(),
-    gracePeriodEndsAt: graceMs > 0 ? new Date(graceMs).toISOString() : null,
-    accountHold: false, // Apple has no equivalent; only Play uses this flag.
-  };
-}
