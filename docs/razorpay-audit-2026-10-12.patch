-// ────────────────────────────────────────────────────────────────────────────
-// Google OIDC token verification — the Android equivalent of Apple Root CA
-// JWS validation. Google's Pub/Sub push delivery attaches an OIDC token in
-// the `Authorization: Bearer` header signed by the service account
-// configured on the push subscription. Verifying this token proves the
-// request actually came from Google's Pub/Sub, not a forger with a leaked
-// shared token.
-//
-// Verification steps (RFC 7515 + RFC 7519):
-//   1. Parse JWT (header.payload.signature, all base64url).
-//   2. Header must declare alg in { RS256, ES256 } — Google uses RS256.
-//   3. Fetch Google's JWKS from https://www.googleapis.com/oauth2/v3/certs
-//      (cached for 1h — Google rotates keys but signs JWTs with old keys
-//      for ~24h after rotation).
-//   4. Find the key in JWKS whose `kid` matches the JWT header's `kid`.
-//   5. Verify the signature over `header.payload`.
-//   6. Check claims: iss == accounts.google.com, aud == expected audience,
-//      email == configured service account, email_verified == true,
-//      exp > now (with 60s clock skew), iat < now + 60s.
-// ────────────────────────────────────────────────────────────────────────────
-const GOOGLE_JWKS_URL = "https://www.googleapis.com/oauth2/v3/certs";
-let cachedGoogleJwks: { keys: Record<string, unknown>[]; expiresAt: number } | null = null;
-const JWKS_TTL_MS = 60 * 60 * 1000;
-
-async function getGoogleJwks(): Promise<Record<string, unknown>[]> {
-  if (cachedGoogleJwks && cachedGoogleJwks.expiresAt > Date.now()) {
-    return cachedGoogleJwks.keys;
-  }
-  const res = await fetch(GOOGLE_JWKS_URL);
-  if (!res.ok) {
-    throw new Error(`JWKS fetch failed: ${res.status}`);
-  }
-  const json = (await res.json()) as { keys: Record<string, unknown>[] };
-  cachedGoogleJwks = { keys: json.keys, expiresAt: Date.now() + JWKS_TTL_MS };
-  return json.keys;
-}
-
-interface OidcResult {
-  ok: boolean;
-  reason?: string;
-  claims?: { email?: string; aud?: string; iss?: string; email_verified?: boolean; exp?: number; iat?: number };
-}
-
-async function verifyGoogleOidcToken(
-  jwt: string,
-  opts: { expectedEmail: string; expectedAudience?: string },
