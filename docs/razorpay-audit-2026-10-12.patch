-export interface ApplePendingRenewalEntry {
-  product_id: string;
-  auto_renew_status?: string;          // "0" off, "1" on
-  expiration_intent?: string;          // "1" user cancel, "2" billing error, "3" price increase decline, "4" product unavailable, "5" unknown
-  is_in_billing_retry_period?: string; // "0" / "1"
