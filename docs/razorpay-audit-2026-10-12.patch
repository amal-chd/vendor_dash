diff -ruN -x o Websites/vendor_web/functions/src/featureFlags.ts adminpanels/vendor_dash/functions/src/featureFlags.ts
--- Websites/vendor_web/functions/src/featureFlags.ts	1970-01-01 05:30:00
+++ adminpanels/vendor_dash/functions/src/featureFlags.ts	2026-10-13 04:43:38
@@ -0,0 +1,62 @@
+import * as admin from "firebase-admin";
+import { HttpsError } from "firebase-functions/v2/https";
+
+/**
+ * Customer-app module switches, with ONE precedence rule shared with the app
+ * (customer_mobile_app PlatformConfigService._rebuild):
+ *
+ *   config/feature_flags.<flag>  →  config/platform.<legacy field>  →  on
+ *
+ * Both admin pages that show these switches (Platform Settings and Feature
+ * Flags) write config/feature_flags. Before this, the server read only
+ * config/platform, so COD could be "off" in the app and still accepted by the
+ * server (or the reverse), and switching off the wallet, Gold, gift cards or
+ * Stay only hid a button — the callables kept taking money.
+ */
+export type ModuleFlag = "cashOnDelivery" | "wallet" | "kadaGold" | "giftCards" | "kadaStay" | "tableBooking";
+
+const LEGACY_FIELD: Record<ModuleFlag, string> = {
+  cashOnDelivery: "codEnabled",
+  wallet: "walletEnabled",
+  kadaGold: "goldEnabled",
+  giftCards: "giftCardsEnabled",
+  kadaStay: "stayEnabled",
+  tableBooking: "tableBookingEnabled",
+};
+
+/** Pure resolution, for tests and for callers that already hold both docs. */
+export function resolveModule(
+  flag: ModuleFlag,
+  flags: Record<string, unknown> | undefined,
+  platform: Record<string, unknown> | undefined,
+): boolean {
+  const f = flags?.[flag];
+  if (typeof f === "boolean") return f;
+  const p = platform?.[LEGACY_FIELD[flag]];
+  if (typeof p === "boolean") return p;
+  return true;
+}
+
+let cache: { at: number; flags: Record<string, unknown>; platform: Record<string, unknown> } | null = null;
+
+/** Live value, cached 30 s per instance (a switch takes effect within that). */
+export async function moduleEnabled(flag: ModuleFlag): Promise<boolean> {
+  if (!cache || Date.now() - cache.at > 30_000) {
+    try {
+      const db = admin.firestore();
+      const [f, p] = await Promise.all([
+        db.collection("config").doc("feature_flags").get(),
+        db.collection("config").doc("platform").get(),
+      ]);
+      cache = { at: Date.now(), flags: f.data() ?? {}, platform: p.data() ?? {} };
+    } catch {
+      // A config read failure must not take a module down.
+      return true;
+    }
+  }
+  return resolveModule(flag, cache.flags, cache.platform);
+}
+
+export async function assertModuleEnabled(flag: ModuleFlag, message: string): Promise<void> {
+  if (!(await moduleEnabled(flag))) throw new HttpsError("failed-precondition", message, { reason: "module_disabled" });
+}
diff -ruN -x o Websites/vendor_web/functions/src/gateway.ts adminpanels/vendor_dash/functions/src/gateway.ts
--- Websites/vendor_web/functions/src/gateway.ts	1970-01-01 05:30:00
+++ adminpanels/vendor_dash/functions/src/gateway.ts	2026-10-12 22:29:55
@@ -0,0 +1,82 @@
+import { logger } from "firebase-functions";
+import { RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET } from "./refunds";
+
+/**
+ * ─────────────────────────────────────────────────────────────────────────
+ * Small Razorpay REST helpers shared by the webhook, the payment sweep and
+ * the refund engine. Callers must bind RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET
+ * on their function.
+ * ─────────────────────────────────────────────────────────────────────────
+ */
+
+const API = "https://api.razorpay.com/v1";
+
+export function razorpayBasicAuth(): string | null {
+  let keyId = "";
+  let keySecret = "";
+  try {
+    keyId = RAZORPAY_KEY_ID.value() || process.env.RAZORPAY_KEY_ID || "";
+    keySecret = RAZORPAY_KEY_SECRET.value() || process.env.RAZORPAY_KEY_SECRET || "";
+  } catch {
+    keyId = process.env.RAZORPAY_KEY_ID || "";
+    keySecret = process.env.RAZORPAY_KEY_SECRET || "";
+  }
+  return keyId && keySecret ? Buffer.from(`${keyId}:${keySecret}`).toString("base64") : null;
+}
+
+/** GET a Razorpay resource; null when it couldn't be read (caller retries later). */
+export async function razorpayGet<T>(path: string): Promise<T | null> {
+  const basic = razorpayBasicAuth();
+  if (!basic) return null;
+  try {
+    const res = await fetch(`${API}${path}`, { headers: { Authorization: `Basic ${basic}` } });
+    if (!res.ok) {
+      logger.warn("razorpayGet failed", { path, status: res.status });
+      return null;
+    }
+    return (await res.json()) as T;
+  } catch (e) {
+    logger.warn("razorpayGet error", { path, e: String(e) });
+    return null;
+  }
+}
+
+/**
+ * Capture an authorized payment. Razorpay voids (and returns to the customer)
+ * any payment left `authorized` for a few days, so a payment we intend to keep
+ * must be captured — normally the account's auto-capture setting does this,
+ * this is the backstop when it is off or delayed.
+ *
+ * Returns true when the payment is captured (now or already).
+ */
+export async function capturePayment(paymentId: string, amountPaise: number, currency = "INR"): Promise<boolean> {
+  const basic = razorpayBasicAuth();
+  if (!basic || !paymentId || !(amountPaise > 0)) return false;
+  try {
+    const res = await fetch(`${API}/payments/${encodeURIComponent(paymentId)}/capture`, {
+      method: "POST",
+      headers: { Authorization: `Basic ${basic}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ amount: amountPaise, currency }),
+    });
+    if (res.ok) return true;
+    const text = await res.text();
+    // Already captured (webhook vs sweep race) is success, not an error.
+    if (/already been captured/i.test(text)) return true;
+    logger.warn("capturePayment failed", { paymentId, status: res.status, body: text.slice(0, 300) });
+    return false;
+  } catch (e) {
+    logger.warn("capturePayment error", { paymentId, e: String(e) });
+    return false;
+  }
+}
+
+/**
+ * A gateway receipt that is unique per attempt. Razorpay treats `receipt` as
+ * an idempotency key and rejects a second order with the same value
+ * ("Duplicate request"), so a receipt derived only from our own id makes every
+ * retry after the first gateway order fail.
+ */
+export function uniqueReceipt(prefix: string): string {
+  const suffix = `_${Date.now().toString(36)}`;
+  return `${prefix.slice(0, 40 - suffix.length)}${suffix}`;
+}
