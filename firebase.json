{
  "hosting": {
    "target": "vendor-dash",
    "public": "dist",
    "cleanUrls": true,
    "predeploy": [
      "npm run doctor",
      "npm run build:with-verse"
    ],
    "postdeploy": [
      "node \"$PROJECT_DIR/scripts/changelog/push-release-manifest.mjs\" hosting"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Kada Dine",
        "supportEmail": "admin@kadadine.com",
        "authorizedRedirectUris": [
          "http://localhost"
        ]
      }
    }
  },
  "//": "Hosting only. Rules, functions and storage deploy from the kada-platform monorepo; this folder carried stale copies (the 2026-11-17 rules deploy from here wiped live rules)."
}
